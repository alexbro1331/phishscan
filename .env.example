# --- Reputation lookups (all optional; with none set, nothing leaves your machine) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=

# --- Web app ---
# Required when the server listens on a network address (Docker, 0.0.0.0). Optional on localhost.
PHISHSCAN_PASSWORD=
# Optional: lets scripts call /api/* with "Authorization: Bearer <token>"
PHISHSCAN_API_TOKEN=
# MAX_UPLOAD_MB=10
# PHISHSCAN_RATE_LIMIT=60
# PHISHSCAN_RETENTION_DAYS=90
# PHISHSCAN_DB=~/.phishscan/phishscan.db
# PHISHSCAN_MEMORY_ONLY=1        # keep cases in memory only; nothing is written to disk
# PHISHSCAN_OFFLINE=1            # never call any reputation service
# PHISHSCAN_TRUST_PROXY=1        # behind a reverse proxy
# PHISHSCAN_COOKIE_SECURE=1      # when served over HTTPS
