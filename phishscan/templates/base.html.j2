<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% block title %}PhishScan{% endblock %}</title>
<style>{% include "style.css" %}</style>
</head><body>
<header class="topbar"><div class="in">
<a class="brand" href="{{ home_href | default('#') }}">
<svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2 4 7v8c0 7.2 5 12.9 12 15 7-2.100 12-7.800 12-15V7L16 2Z" fill="#fff" fill-opacity=".18" stroke="#fff" stroke-width="2"/><path d="m10.500 16 4 4 7.500-8" stroke="#fff" stroke-width="2.500" stroke-linecap="round" stroke-linejoin="round"/></svg>
PhishScan</a>
<span class="tag">Phishing email triage &middot; v{{ version }}</span>
</div></header>
<main class="wrap">
{% block content %}{% endblock %}
</main>
</body></html>
