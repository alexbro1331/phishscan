{% extends "base.html.j2" %}
{% block title %}PhishScan &middot; Batch summary{% endblock %}
{% block content %}
<section class="card">
  <h2>Batch summary <span class="n">{{ total }} email{{ "" if total == 1 else "s" }}</span></h2>
  <div class="tiles" style="grid-template-columns:repeat(4,1fr)">
    <div class="tile bad"><div class="k">Malicious</div><div class="v">{{ counts.Malicious }}</div></div>
    <div class="tile warn"><div class="k">Suspicious</div><div class="v">{{ counts.Suspicious }}</div></div>
    <div class="tile ok"><div class="k">Safe</div><div class="v">{{ counts.Safe }}</div></div>
    <div class="tile"><div class="k">Unreadable</div><div class="v">{{ counts.Error }}</div></div>
  </div>
</section>
<section class="card">
  <div class="table-scroll"><table class="data">
    <tr><th>File</th><th>Verdict</th><th>Score</th><th>From</th><th>Subject</th><th>Report</th></tr>
    {% for r in rows %}<tr>
      <td>{{ r.file }}</td>
      <td><span class="chip {{ 'bad' if r.verdict == 'Malicious' else 'warn' if r.verdict in ('Suspicious', 'Error') else 'ok' }}">{{ r.verdict }}</span></td>
      <td>{{ r.score }}</td><td>{{ r.from }}</td><td>{{ r.subject or r.findings }}</td>
      <td>{% if r.report %}<a href="{{ r.report }}">Open</a>{% endif %}</td>
    </tr>{% endfor %}
  </table></div>
</section>
{% endblock %}
