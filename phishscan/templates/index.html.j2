{% extends "base.html.j2" %}
{% block title %}PhishScan &middot; Phishing email analyzer{% endblock %}
{% block content %}
<section style="padding:10px 0 26px">
  <h1 style="font-size:2.1rem;line-height:1.2;margin:0 0 10px">Is that email a phish?<br>Find out in seconds.</h1>
  <p class="lead">Upload a suspicious email and get an explainable verdict: authentication checks, look-alike domains, tricky links, risky attachments, the mail route and MITRE ATT&amp;CK mapping.</p>
</section>

<section class="card">
  <form class="upload" action="/analyze" method="post" enctype="multipart/form-data">
    <div style="font-size:1.1rem;font-weight:700">Choose an email file (.eml)</div>
    <input type="file" name="eml" accept=".eml,message/rfc822" required>
    <button class="btn" type="submit">Analyze email</button>
    <div class="muted" style="margin-top:12px;font-size:.85rem">Max {{ max_mb }} MB. Analyzed in memory, never stored. Attachments are hashed, never opened. Links are never visited.</div>
  </form>
</section>

<section class="features">
  <div class="card"><h2>Explainable score</h2><div class="muted">Every point of the 0&ndash;100 risk score comes with a plain-English reason, so you can trust or override it.</div></div>
  <div class="card"><h2>Built for real incidents</h2><div class="muted">Handles malformed headers, HTML-only mail, punycode look-alikes, link-text tricks and double-extension attachments.</div></div>
  <div class="card"><h2>Safe by design</h2><div class="muted">No JavaScript, defanged indicators, no link visits{% if lookups %}. Reputation lookups (VirusTotal / AbuseIPDB) are enabled{% else %}. Reputation lookups are off on this server{% endif %}.</div></div>
</section>

<section class="card" style="margin-top:18px">
  <h2>How to export an .eml</h2>
  <div class="grid-2">
    <div><b>Gmail</b><div class="muted">Open the message &rarr; &#8942; menu &rarr; <i>Download message</i>.</div></div>
    <div><b>Outlook</b><div class="muted">Drag the message to your desktop, or <i>File &rarr; Save As</i> and choose <i>.eml</i>. Use <i>Forward as attachment</i> inside your company to preserve headers.</div></div>
  </div>
</section>
<p class="foot">Automated triage aid &mdash; a human analyst should confirm the verdict before taking action.<br>API: <code>POST /api/analyze</code> (multipart field <code>eml</code>) &middot; Health: <code>/healthz</code></p>
{% endblock %}
