{% extends "base.html.j2" %}
{% block title %}PhishScan &middot; Error {{ code }}{% endblock %}
{% block content %}
<section class="card v-Malicious" style="border-top:6px solid var(--vc);text-align:center;padding:40px 22px">
  <div class="pill">Error {{ code }}</div>
  <h1 style="margin:14px 0 8px">We couldn't analyze that</h1>
  <p class="muted" style="max-width:560px;margin:0 auto 22px">{{ message }}</p>
  <a class="btn" href="/">Try another email</a>
</section>
{% endblock %}
